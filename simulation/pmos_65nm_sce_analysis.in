##############################################################

############################
# LOW-FREQ (Quasi-static) C-V
############################
#load infile=solution_at_equilibrium

solve vsource=0 name=source
solve vdrain =0 name=drain
solve vbulk  =0 name=bulk

solve vgate=0
solve vgate=0.1
solve vgate=0.5
solve vgate=1.0
solve vgate=+$"Vdd" name=gate
solve vgate=2.0
solve vgate=3.0

log outf=CV_QSCV_lowfreq.log
solve vstep=-0.1 vfinal=-3*$"Vdd" name=gate qscv
log off

 
tonyplot CV_QSCV_lowfreq.log

############################
# HIGH-FREQ (AC) C-V
############################
load infile=solution_at_equilibrium

solve vsource=0 name=source
solve vdrain =0 name=drain
solve vbulk  =0 name=bulk

solve vgate=0
solve vgate=0.1
solve vgate=0.5
solve vgate=1.0
solve vgate=2.0
solve vgate=3.0

log outf=CV_AC_highfreq_1MHz.log
solve vstep=-0.1 vfinal=-3.0 name=gate AC freq=$"GateFrequency" ANAME=gate
log off


tonyplot CV_AC_highfreq_1MHz.log


