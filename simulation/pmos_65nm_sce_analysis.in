go atlas simflags = "-p 12"

# Parameter definition (65 [nm] technology node values)

set scaling_factor_k = 65/90
set channel_length = 0.090*$"scaling_factor_k"
set gate_ox_thickness = 0.002*$"scaling_factor_k"

set source_drain_length = $"channel_length"*1.5
set source_drain_junc_depth = 0.060*$"scaling_factor_k"

set source_drain_doping = 1e19/($"scaling_factor_k"**2)

set electrode_length = $"channel_length"*$"scaling_factor_k"
set electrode_height = 0.02

set substrate_depth = 0.2*$"scaling_factor_k"
set substrate_doping = 1e18/($"scaling_factor_k"**2)

set Qss = 5e10
set Vdd = 1.2

Set GateFrequency=1e3
#______________ A. Structure definition ______________

#1. Mesh initialization
#---------------------------------------------------
# X-direction mesh (CRITICAL for tunneling)
#---------------------------------------------------
mesh space.mult=1.0 width=10*$"channel_length"

# Global boundaries
x.mesh loc=0.00 spac=0.05
x.mesh loc=2*$"source_drain_length"+$"channel_length" spac=0.05

# Source-channel interface
x.mesh loc=$"source_drain_length" spac=0.002

# Drain-channel interface
x.mesh loc=$"source_drain_length"+$"channel_length" spac=0.002

# Dense lateral mesh INSIDE gate oxide / channel (REQUIRED)
x.mesh loc=$"source_drain_length"+0.05*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.15*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.25*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.35*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.45*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.55*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.65*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.75*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.85*$"channel_length" spac=0.001
x.mesh loc=$"source_drain_length"+0.95*$"channel_length" spac=0.001

#---------------------------------------------------
# Y-direction mesh (oxide + channel refinement)
#---------------------------------------------------

# Vacuum above gate
y.mesh loc=-0.05 spac=0.01

# Oxide region — VERY fine mesh (mandatory)
y.mesh loc=-$"gate_ox_thickness" spac=0.0002
y.mesh loc=-0.75*$"gate_ox_thickness" spac=0.0002
y.mesh loc=-0.50*$"gate_ox_thickness" spac=0.0002
y.mesh loc=-0.25*$"gate_ox_thickness" spac=0.0002
y.mesh loc=0.00 spac=0.0002

# Silicon surface and channel
y.mesh loc=0.002 spac=0.002
y.mesh loc=0.005 spac=0.003
y.mesh loc=0.010 spac=0.005
y.mesh loc=0.015 spac=0.005
y.mesh loc=0.030 spac=0.01
y.mesh loc=0.060 spac=0.02
y.mesh loc=0.100 spac=0.03

# Substrate bottom
y.mesh loc=$"substrate_depth" spac=0.1

#drain-channel interface (If you specify 3 decimal digits after the decimal point, Silvaco will give you an error in the mesh, and it will tell you the error is in the line directly after the last mesh line written, whatever that code line after the mesh was!)

#2. Region initialization

#Vacuum region
region number=1  material=Vac

#Substrate region
region number=2 x.min=0.00 x.max=2*$"source_drain_length" + $"channel_length" y.min=0 y.max=$"substrate_depth" material=Silicon name=substrate_bulk

#Source region
region number=3 x.min=0.00 x.max=$"source_drain_length" y.min=0 y.max=$"source_drain_junc_depth" material=silicon name = source_bulk

#Drain region
region number=4 x.min=$"source_drain_length" + $"channel_length" x.max=2*$"source_drain_length" + $"channel_length" y.min=0 y.max=$"source_drain_junc_depth" material=silicon name = drain_bulk

#Oxide region
region number=5 x.min=$"source_drain_length" x.max=$"source_drain_length" + $"channel_length" y.min=-$"gate_ox_thickness" y.max=0.00 material=SiO2 name = oxide

#Polysilicon gate electrode
region number=6 x.min=$"source_drain_length" x.max=$"source_drain_length" + $"channel_length" y.min=-1 y.max=-$"gate_ox_thickness" material=poly name = gate_electrode


#Polysilicon Source Electrode
region number=7 x.min=0 x.max=$"electrode_length" y.min=-$"electrode_height" y.max=0 material=Alum name = source_electrode


#Polysilicon Drain Electrode
region number=8 x.min=2*$"source_drain_length" + $"channel_length" -$"electrode_length"  x.max=2*$"source_drain_length" + $"channel_length" y.min=-$"electrode_height" y.max=0 material=Alum name = drain_electrode



#3. Electrode definition
electrode name=gate   region = gate_electrode
electrode name=drain  region = drain_electrode
electrode name=source region = source_electrode
electrode name=bulk bottom



#4. Doping

#A. Substrate doping
doping uniform conc=$"substrate_doping" n.type region=substrate_bulk

#B. Source and drain doping
doping uniform conc=$"source_drain_doping" p.type region=source_bulk
doping uniform conc=$"source_drain_doping" p.type region=drain_bulk



#______________ B. Material and physical model definition ______________

#1. Material parameter value definition
material silicon EG300=1.12 permittivity=11.7 ni=6.68e9

#2. Contact material (electrode material) parameter definition
contact name=gate p.poly

#Let the source and drain regions be perfect ohmic contacts, because no material was selected for the here.
contact name=source
contact name=drain
contact name=bulk

#Probe creation
probe name="Electron con"  N.conc x=$"source_drain_length" + $"channel_length"/2 y=0.0000001
probe name="Hole con"  P.conc x=$"source_drain_length" + $"channel_length"/2 y=0.0000001

#3. oxide interface charge
interface x.min= $"source_drain_length" x.max= $"source_drain_length" + $"channel_length" y.min=-$"gate_ox_thickness"/2 y.max=0.005 qf=$"Qss"


#4.1 Physical models and equations to be solved solutions
models MOS fermi CVT print auger srh

#4.2 Physical parameters we want Silvaco to make available for plotting
output CON.BAND VAL.BAND U.SRH QFN QFP band.param QSS




#______________ C. Numerical Method Selection ______________
method newton maxtrap=10 climit=1e-4





# ==========================================================
# I-V Characteristics Curve
# ==========================================================

# --- Curve A: Linear Region (Vds = -50 mV) ---
solve init
# Set Drain to -50mV (Linear region)
solve vdrain=-0.05
# Sweep Gate from 0 to -1.2V
log outf=Ids_Vgs_Vd_50mV.log
solve vgate=0 vstep=-0.01 vfinal=-1.2 name=gate
log off

#extraction on the linear region transfer curve (Vds = -50 mV)
extract init infile="Ids_Vgs_Vd_50mV.log"
extract name="SS_linear_mV/dec" 1000.0 / slope(maxslope(curve(abs(v."gate"), log10(abs(i."drain")))))

# --- Curve B: Saturation Region (Vds = -1.2 V) ---
solve init
# Ramp Drain to -1.2V (Saturation region)
solve vdrain=0 vstep=-0.1 vfinal=-1.2 name=drain
# Sweep Gate from 0 to -1.2V
log outf=Ids_Vgs_Vd_1.2V.log
solve vgate=0 vstep=-0.01 vfinal=-1.2 name=gate
log off

#Subthreshold Swing from Saturation Region (Vds = -1.2 V)

extract init infile="Ids_Vgs_Vd_1.2V.log"
extract name="SS_sat_mV/dec" 1000.0 / slope(maxslope(curve(abs(v."gate"), log10(abs(i."drain")))))

# Plot Ids-Vgs
tonyplot -overlay Ids_Vgs_Vd_50mV.log Ids_Vgs_Vd_1.2V.log -set "log scale"


# Note: We use abs() because PMOS current and voltage are negative
# ==========================================================
# 3. Ids-Vds Characteristics (Output Curve)
#Target Vgs: -0.5, -0.8, -1.0, -1.2 V
# ==========================================================

# --- Curve 1: Vgs = -0.5 V ---
solve init
solve vgate=-0.5
log outf=Ids_Vds_Vg_0.5V.log
solve vdrain=0 vstep=-0.05 vfinal=-1.2 name=drain
log off

# --- Curve 2: Vgs = -0.8 V ---
solve init
solve vgate=-0.5 vstep=-0.1 vfinal=-0.8 name=gate
log outf=Ids_Vds_Vg_0.8V.log
solve vdrain=0 vstep=-0.05 vfinal=-1.2 name=drain
log off

# --- Curve 3: Vgs = -1.0 V ---
solve init
solve vgate=-0.5 vstep=-0.1 vfinal=-1.0 name=gate
log outf=Ids_Vds_Vg_1.0V.log
solve vdrain=0 vstep=-0.05 vfinal=-1.2 name=drain
log off

# --- Curve 4: Vgs = -1.2 V ---
solve init
solve vgate=-0.5 vstep=-0.1 vfinal=-1.2 name=gate
log outf=Ids_Vds_Vg_1.2V.log
solve vdrain=0 vstep=-0.05 vfinal=-1.2 name=drain
log off

# Plot Ids-Vds family of curves
tonyplot -overlay Ids_Vds_Vg_0.5V.log Ids_Vds_Vg_0.8V.log Ids_Vds_Vg_1.0V.log Ids_Vds_Vg_1.2V.log



#_________________________________________V_TH temp variation analysis__________________________________________

probe lat.temp X=0.125 Y=0.0001
PROBE name="Electron Concentration (/cm^3)"	N.CONC X=0.125 Y=0.00001
PROBE name="Hole Concentration (/cm^3)"		P.CONC X=0.125 Y=0.00001

save outf= MOSFET_STRUCT.str


#_____ TEMP Analysis @300K _____
go atlas

mesh infile=MOSFET_STRUCT.str
contact name=gate p.poly
interface x.min=$"source_drain_length" x.max=$"source_drain_length" + $"channel_length" qf=$"Qss"
models MOS fermi CVT print
models temperature=300 kla analytic


probe lat.temp X=0.125 Y=0.0001
PROBE name="Electron Concentration (/cm^3)"	N.CONC X=0.125 Y=0.00001
PROBE name="Hole Concentration (/cm^3)"		P.CONC X=0.125 Y=0.00001

solve init
solve vstep=-0.1 vfinal=-0.7 name=drain

solve vgate=0 vstep=0.1 vfinal=1.2 name=gate
log outf= ID_VGS_TEMP300.log
solve  vstep=-0.1 vfinal=-1.2 name=gate
log off
solve  vstep=-0.1 vfinal=-1 name=gate
solve vstep=0.1 vfinal=0.3 name=drain
log outf= ID_VDS_TEMP300.log
solve vstep=-0.1 vfinal=-1.2 name=drain
log off
extract init infile="ID_VGS_TEMP300.log"
extract name="VTP_AT_TEMP_300" x.val from curve(v."gate", probe."Hole Concentration (/cm^3)") where y.val=$"substrate_doping"

extract name="VFB_AT_TEMP_300" x.val from curve(v."gate", probe."Electron Concentration (/cm^3)") where y.val=$"substrate_doping"

extract name="VDep_AT_TEMP_300" x.val from curve(v."gate", probe."Electron Concentration (/cm^3)" - probe."Electron Concentration (/cm^3)") where y.val=0
#_____ TEMP Analysis @350K _____
go atlas

mesh infile=MOSFET_STRUCT.str
contact name=gate p.poly
interface x.min=$"source_drain_length" x.max=$"source_drain_length" + $"channel_length" qf=$"Qss"
models MOS fermi CVT print
models temperature=350 kla analytic


probe lat.temp X=0.125 Y=0.0001
PROBE name="Electron Concentration (/cm^3)"	N.CONC X=0.125 Y=0.00001
PROBE name="Hole Concentration (/cm^3)"		P.CONC X=0.125 Y=0.00001

solve init
solve vstep=-0.1 vfinal=-0.7 name=drain

solve vgate=0 vstep=0.1 vfinal=1.2 name=gate
log outf= ID_VGS_TEMP350.log
solve  vstep=-0.1 vfinal=-1.2 name=gate
log off
solve  vstep=-0.1 vfinal=-1 name=gate
solve vstep=0.1 vfinal=0.3 name=drain
log outf= ID_VDS_TEMP350.log
solve vstep=-0.1 vfinal=-1.2 name=drain
log off
extract init infile="ID_VGS_TEMP350.log"
extract name="VTP_AT_TEMP_350" x.val from curve(v."gate", probe."Hole Concentration (/cm^3)") where y.val=$"substrate_doping"

extract name="VFB_AT_TEMP_350" x.val from curve(v."gate", probe."Electron Concentration (/cm^3)") where y.val=$"substrate_doping"

extract name="VDep_AT_TEMP_350" x.val from curve(v."gate", probe."Electron Concentration (/cm^3)" - probe."Electron Concentration (/cm^3)") where y.val=0

