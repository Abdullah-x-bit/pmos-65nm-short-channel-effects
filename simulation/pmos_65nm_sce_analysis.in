#3. CV Characterestics

# Starting the AC analysis
#C_V_HighFreq_Characteristics_at_drain0
solve vgate=0 outf=solve_temp_vgate
solve vgate=0.5 outf=solve_temp_gate0.5
solve vgate=1 outf=solve_temp_vgate1
solve vgate=1.5 outf=solve_temp_vgate1.5
solve vgate=2 outf=solve_temp_vgate2
solve vgate=2.5 outf=solve_temp_vgate2.5
solve vgate=3 	outf=solve_temp_gatebias
log outf = C_V_HighFreq_Characteristics_at_drain0.log
solve vstep=-0.1 vfinal=-3.0 name=gate AC freq=$"GateFrequency" ANAME=gate
tonyplot C_V_HighFreq_Characteristics_at_drain0.log
log off

#C_V_LowFreq_Characteristics_at_drain0
load infile=solve_temp_vgate
solve prev
load infile=solve_temp_gatebias
log outf = C_V_LowFreq_Characteristics_at_drain0.log
solve vstep=0.1 vfinal=3.0 name=gate QSCV
tonyplot C_V_LowFreq_Characteristics_at_drain0.log
log off

