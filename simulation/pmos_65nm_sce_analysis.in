#Ion and Ioff optimization sweeps
#ID-VDS Charcterstics
 
#1. On-current
solve vstep=-.2 vfinal=-1.2 name=gate 

log outf = On_current.log 
solve  vstep=-0.3 vfinal=-1.2 name=drain 
log off

extract init infile = "On_current.log"
extract name="I_on" min(i."drain")

tonyplot On_current.log

#2. Off current
solve vdrain=0
solve vgate=0
log outf = Off_current.log 
solve  	vstep=-0.2 vfinal=-1.2 name=drain
log off

tonyplot Off_current.log -set ID_VGS.set

extract init infile = "Off_current.log"
extract name="I_off" min(i."drain")
