tonyplot -overlay ID_VDS_TEMP550.log ID_VDS_TEMP500.log ID_VDS_TEMP450.log ID_VDS_TEMP400.log ID_VDS_TEMP350.log ID_VDS_TEMP300.log 
save outf = struc.str
###################################################################################################################################################################################################################
######################################################
#______________ Tunneling Analysis  ______________

# Self-consistent electrons and holes - forward bias

go atlas 
mesh infile=MOSFET_STRUCT.str
contact name=gate p.poly
interface x.min=$"source_drain_length" x.max=$"source_drain_length" + $"channel_length" qf=$"Qss"
#set the workfunction and effective masses for the top contact

#set models including self-consistent electron tunnelling
models MOS fermi CVT
models temperature=300 kla analytic
models print conmob fldmob consrh qtnlsc.el qtnlsc.ho  qtnl.derivs

#set some parameters to help convergence 
method newton clim.dd=1e8 dvmax=0.1
output CON.BAND VAL.BAND U.SRH QFN QFP band.param
# Get I-V curves

solve init
solve vstep=-0.1 vfinal=-0.7 name=drain

solve vgate=0 vstep=0.1 vfinal=2.2 name=gate
# Go up to a forward bias of -1.2 Volts
log outfile=Electron_Hole_tunneling.log j.hole j.electron j.tun 
solve vstep=-0.05 vfinal=-1.2 name=gate
log off
save outf=tunnel.str
#
tonyplot -append Electron_Hole_tunneling.log ID_VGS_TEMP300.log



#__________________________________________________________________________
#______________ D. solve the equations ______________

solve init outf=solution_at_equilibrium

#______________ D. Extract Results ______________

#Structure at equilibrium
save outf=00_65nm_structure.str
#tonyplot 00_65nm_structure.str

###_________________IV_characteristics_________________________
#1. ID-VGS Charcterstics 

#solve vstep=-.25 vfinal=-1 name=drain 
#
#log outf = 0.ID_VGS_Charcterstics.log 
#solve  vstep=-0.1 vfinal=-7 name=gate 
#log off
#
#tonyplot 0.ID_VGS_Charcterstics.log

###2. ID-VDS Charcterstics 
solve vgate=0 vstep=-0.2 vfinal=-2 name=gate 
solve vdrain=0

log outf = 1.ID_VDS_Charcterstics.log 
solve 	 vstep=-0.1 vfinal=-1.1 name=drain 

#Plot the electric field at velocity saturation
save outf=E_field_at_vel_sat.str

solve  vstep=-0.1 vfinal=-6 name=drain 
log off

tonyplot 1.ID_VDS_Charcterstics.log -set ID_VDS_set.set
tonyplot E_field_at_vel_sat.str



#______________DIBL analysis______________

load infile=solution_at_equilibrium

#IV curves for DIBL
#Curve for VD=-0.5
solve vdrain=-0.25
solve vdrain=-0.5

#Setting vgate before the log file starts recording and not inside the voltage sweep avoids glitches in the plots.
solve vgate=0

log outf = 01_ID_VGS_V_drain0v5.log
#These curves in this sweep are used to plot the energy band diagram for the PMOS device
save outf=10_ID_VGS_V_drain0v5_gate0.str

solve vstep=-0.1 vfinal=-1 name=gate
save outf=11_ID_VGS_V_drain0v5_gate1.str

solve vstep=-0.1 vfinal=-2 name=gate
save outf=12_ID_VGS_V_drain0v5_gate2.str

solve vstep=-0.1 vfinal=-3 name=gate
save outf=13_ID_VGS_V_drain0v5_gate3.str

log off

#Plot energy bands for a -0.5[V] V_drain PMOS for various values of V_G
tonyplot 10_ID_VGS_V_drain0v5_gate0.str 11_ID_VGS_V_drain0v5_gate1.str 12_ID_VGS_V_drain0v5_gate2.str 13_ID_VGS_V_drain0v5_gate3.str -set energy_band_set.set


save outf=01_ID_VGS_V_drain0v5.str



#Curve for VD=-0.5
solve vdrain=-0.75
solve vdrain=-1

solve vgate=0
log outf = 02_ID_VGS_V_drain1.log
solve vstep=-0.1 vfinal=-3 name=gate
log off
save outf=02_ID_VGS_V_drain1.str



#Curve for VD=-1.5
solve vdrain=-1.25
solve vdrain=-1.5

solve vgate=0
log outf = 03_ID_VGS_V_drain1v5.log
solve vstep=-0.1 vfinal=-3 name=gate
log off
save outf=03_ID_VGS_V_drain1v5.str



#Curve for VD=-2
solve vdrain=-1.75
solve vdrain=-2

solve vgate=0
log outf = 04_ID_VGS_V_drain2.log
solve vstep=-0.1 vfinal=-3 name=gate
log off
save outf=04_ID_VGS_V_drain2.str



#Curve for VD=-2.5
solve vdrain=-2.25
solve vdrain=-2.5

solve vgate=0
log outf = 05_ID_VGS_V_drain2v5.log
solve vstep=-0.1 vfinal=-3 name=gate
log off
save outf=05_ID_VGS_V_drain2v5.str



#Curve for VD=-3
solve vdrain=-2.75
solve vdrain=-3
solve vgate=0

log outf = 06_ID_VGS_V_drain3.log

#These curves in this sweep are used to plot the energy band diagram for the PMOS device
save outf=10_ID_VGS_V_drain3_gate0.str

solve vstep=-0.1 vfinal=-1 name=gate
save outf=11_ID_VGS_V_drain3_gate1.str

solve vstep=-0.1 vfinal=-2 name=gate
save outf=12_ID_VGS_V_drain3_gate2.str

solve vstep=-0.1 vfinal=-3 name=gate
save outf=13_ID_VGS_V_drain3_gate3.str

save outf=06_ID_VGS_V_drain3.str

#Plot energy bands for a -3[V] V_drain PMOS for various values of V_G (This and the previous tonyplot indicate stark differences in the band diagram due to lowering).
tonyplot 10_ID_VGS_V_drain3_gate0.str 11_ID_VGS_V_drain3_gate1.str 12_ID_VGS_V_drain3_gate2.str 13_ID_VGS_V_drain3_gate3.str -set energy_band_set.set
log off


#Plot the ID-VGS DIBL curves and structure files
tonyplot -overlay 01_ID_VGS_V_drain0v5.log 02_ID_VGS_V_drain1.log 03_ID_VGS_V_drain1v5.log 04_ID_VGS_V_drain2.log 05_ID_VGS_V_drain2v5.log 06_ID_VGS_V_drain3.log

#Electric field plots
tonyplot 01_ID_VGS_V_drain0v5.str 02_ID_VGS_V_drain1.str 03_ID_VGS_V_drain1v5.str 04_ID_VGS_V_drain2.str 05_ID_VGS_V_drain2v5.str 06_ID_VGS_V_drain3.str -set E_field.set



#______Extract VTH values for DIBL calcuation__________

#1.Get V_T for V_D = 0[V]
load infile=solution_at_equilibrium

solve vdrain=0

solve vgate=0 vstep=0.1 vfinal=1 name=gate
log outf = 00Electron_hole_con_vs_VG_VD_0.log
solve vstep =-0.1 vfinal=-4 name=gate
log off

extract init infile="00Electron_hole_con_vs_VG_VD_0.log"
extract name="VTP0" x.val from curve(v."gate", probe."Hole con") where y.val=$"substrate_doping"

