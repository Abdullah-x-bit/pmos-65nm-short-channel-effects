contact name=gate p.poly
interface x.min=$"source_drain_length" x.max=$"source_drain_length" + $"channel_length" qf=$"Qss"
models MOS fermi CVT print
models temperature=400 kla analytic


probe 						lat.temp X=0.125 Y=0.0001
PROBE name="Electron Concentration (/cm^3)"	N.CONC   X=0.125 Y=0.00001
PROBE name="Hole Concentration (/cm^3)"		P.CONC   X=0.125 Y=0.00001

